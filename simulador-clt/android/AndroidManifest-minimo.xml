<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto do Simulador CLT ES.

  VARIANTE MINIMA de diagnostico: sem resources.arsc e sem icone, com o nome do
  app como texto literal. E o APK mais simples que ainda e valido, usado para
  isolar se a tabela de recursos montada a mao e o que o Android rejeita.

  configChanges = 0x40007fff cobre TODAS as mudancas de configuracao, para que
  nada recrie a Activity (o que reiniciaria o WebView no meio da run).
  screenOrientation = 1 e SCREEN_ORIENTATION_PORTRAIT; vai como numero porque o
  compilador de manifesto usado aqui nao resolve o nome do enum. Fica INT_DEC,
  que e como o aapt tambem emite enums.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dfbg.simuladorcltes"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true" />

    <application
        android:label="Simulador CLT ES"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name="com.dfbg.simuladorcltes.MainActivity"
            android:launchMode="singleTop"
            android:screenOrientation="1"
            android:configChanges="0x40007fff"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
